# Copy to server/.env (docker compose reads it). Never commit the real file.
TIMEBUTLER_USERNAME=your.email@example.com
TIMEBUTLER_PASSWORD=YourStrongPassword

# Shared secret for n8n (Header Auth credential "Authorization: Bearer <token>").
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TB_API_TOKEN=

# Schedule (defaults shown)
# TB_START_WINDOW=09:00-09:30
# TB_SHIFT_HOURS=7.5-9          # start -> stop, break included
# TB_BREAK_MINUTES=30
# TB_BREAK_WINDOW=12:00-13:00
# TB_WORKDAYS=1,2,3,4,5         # ISO weekdays, Monday = 1
# TB_TIMEZONE=Europe/Berlin

# Skip public holidays: country or country-subdivision, e.g. DE, DE-BY, DE-NW
# TB_HOLIDAY_REGION=DE-BY
